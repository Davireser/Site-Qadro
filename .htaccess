# Bloqueia acesso HTTP a pastas e arquivos que não fazem parte do site publicado.
# Necessário porque a pasta do projeto é servida diretamente pelo Apache
# (em htdocs há uma junção apontando para cá).

# Pastas internas: repositório, configurações de ferramentas e arquivos de design (.ai, .pdf).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|\.claude|design)(/|$) - [F,L]
</IfModule>

# Arquivos soltos que não devem ser baixados.
<FilesMatch "^(\.gitignore|\.htaccess|README\.md|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
